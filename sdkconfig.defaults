# Il supporto PPP di lwIP e' disattivato di default in ESP-IDF ma serve a
# cellular_link.c (ESP_NETIF_DEFAULT_PPP(), usato per il dial-up dati via
# SIM7600 attraverso esp_modem). Valori ripresi dall'esempio ufficiale
# pppos_client di esp_modem (stessi usati con successo sul progetto
# gemello baseesp32/T-Internet-COM).
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_PPP_ENABLE_IPV6=n


# Scheda con 16MB di flash reali (ESP32-S3R8): partizione app allargata a
# 2MB (vedi partitions.csv) - qui non serve la partizione da 4MB del
# progetto gemello perche' questa scheda non ha Bluetooth Classic (solo
# BLE, non implementata), quindi niente stack Bluedroid pesante da
# ospitare.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Schema di partizioni OTA (otadata + ota_0 + ota_1, vedi partitions.csv):
# un aggiornamento fallito (crash prima di autoconfermarsi, vedi
# ota_update.c) fa tornare automaticamente il bootloader all'immagine
# precedente funzionante al riavvio successivo - un dispositivo in campo
# non puo' restare bloccato da un aggiornamento andato male.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Default 10: gia' quasi saturo solo col server web (fino a 7 socket
# aperti contemporaneamente) piu' la trasmissione UDP NMEA e i tentativi
# del client NTRIP - non restava spazio per aprire un socket in piu' per
# l'aggiornamento online (HTTPS verso GitHub), confermato su hardware
# reale ("esp-tls: Failed to create socket"). Alzato per dare margine.
CONFIG_LWIP_MAX_SOCKETS=16

# Il default (3584 byte) va in overflow: app_main() chiama net_manager_start()
# che esegue esp_wifi_init()/wifi_link_init() (WiFi+mbedtls) in modo sincrono
# sullo stack del task "main", prima ancora di creare net_manager_task -
# confermato da un crash reale su hardware (T-ETH-Elite) con lo stack
# default. Stesso valore usato dagli esempi ufficiali di esp_modem che
# inizializzano il modem/mbedtls direttamente in app_main.
# Alzato di nuovo a 10240 (era 8192) quando i 9 nuovi campi float lever-arm/
# RBV di GNSS_CHIP_BYNAV_M21D (settings.h) hanno fatto ricrescere
# sizeof(app_settings_t) - bastavano 36 byte in piu' per far ritraboccare
# lo stack esattamente nello stesso punto (init WiFi), confermato da un
# secondo crash reale su hardware: app_settings_t viene passata per valore
# (non per puntatore) in piu' punti della catena di chiamate di app_main(),
# quindi ogni funzione che ne fa una copia locale aggiunge il suo peso
# pieno allo stack invece di uno solo condiviso - margine ora piu' ampio
# per assorbire crescite future analoghe della struct.
# Alzato a 12288 in 1.19.57: una sola copia in piu' di app_settings_t in
# app_main() (per la modalita' attiva) bastava a mandarlo in overflow a ogni
# avvio - margine per le prossime aggiunte.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Serve per calcolare l'uso CPU per core mostrato nella scheda Stato
# (sys_stats.c, basato sul tempo di esecuzione del task IDLE di ciascun
# core) - overhead trascurabile (solo un contatore aggiornato nel loop
# idle), nessun impatto sulle prestazioni.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Il default (nomi file solo formato classico "8.3", es. "BOOT_0.LOG")
# rifiutava con errno EINVAL (confermato su hardware reale) i nomi usati
# dall'archivio firmware su SD ("v1.19.22.bin" - piu' di 8 caratteri e
# due punti, non valido in 8.3). Allocato sull'heap (non sullo stack, vedi
# CONFIG_FATFS_LFN_STACK) per non aggiungere ulteriore pressione sullo
# stack dei task che toccano la SD, gia' causa di piu' di uno stack
# overflow reale in questo stesso progetto.
CONFIG_FATFS_LFN_HEAP=y

# Console di log solo su USB (USB-Serial-JTAG, la porta COM del PC), NON
# sulla UART0: sulla T-ETH-Elite la UART0 esce su GPIO43/44, cioe' i pin
# fisici 8/10 (TX/RX) del connettore a 40 pin, gli stessi dove un HAT GNSS
# per Raspberry Pi (es. ZED-F9P) porta la sua seriale. Con la console li'
# il log finiva dentro il ricevitore e il ricevitore non era raggiungibile.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Serve a net_util.h (net_close_now): i client NTRIP chiudono con RST invece
# di lasciare i socket in TIME_WAIT per 120 s - accumulandosi oltre
# CONFIG_LWIP_MAX_ACTIVE_TCP bloccavano ogni risposta TCP della scheda
# (pannello web) mentre il caster rifiutava le connessioni.
CONFIG_LWIP_SO_LINGER=y

# Interrupt del driver I2C eseguibile anche con la cache disabilitata
# (letture/scritture della flash: archiviazione del firmware su SD, salvataggio
# impostazioni NVS, aggiornamenti OTA). Senza, durante quelle operazioni
# l'interrupt veniva ritardato e le transazioni verso il ricevitore u-blox
# via I2C fallivano (errori all'avvio visti sul dispositivo, 1.19.68).
CONFIG_I2C_ISR_IRAM_SAFE=y

# Settore FATFS da 512 byte (era 4096): le microSD usano sempre settori da
# 512, e con 4096 ogni montaggio riservava ~4 KB in piu' di buffer (piu'
# altri ~3,5 KB per ogni file aperto). Con il pannello molto usato il
# montaggio della SD falliva per memoria insufficiente (ESP_ERR_NO_MEM,
# visto il 30/09/2026). Nessun FAT su flash interna in questo firmware.
CONFIG_FATFS_SECTOR_512=y
# CONFIG_FATFS_SECTOR_4096 is not set

# Ora del giorno nei log ("I (15:32:05.123) tag: ...") invece dei ms
# dall'avvio: con l'NTP (time_sync.c) si sa quando e' successo qualcosa.
# Prima della sincronizzazione parte da 00:00:00 all'accensione.
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y
# CONFIG_LOG_TIMESTAMP_SOURCE_RTOS is not set

# Anche il settore del wear levelling a 512 byte: FatFs dimensiona i buffer
# su MAX(settore SD, settore WL), quindi con il WL a 4096 il settore SD da
# 512 della 1.19.74 non riduceva nulla (4 KB per ogni file aperto: il log
# diagnostico, 4 file, chiedeva 16 KB contigui e spesso falliva con
# ESP_ERR_NO_MEM). Nessun FAT su flash interna in questo firmware.
CONFIG_WL_SECTOR_SIZE_512=y
# CONFIG_WL_SECTOR_SIZE_4096 is not set

# Buffer fissi di ricezione WiFi: lasciati a 10 (default). Nella 1.19.86
# erano stati ridotti a 6 per risparmiare 6,4 KB, ma con quella versione sono
# comparsi crash rari nel driver WiFi (ppTask, salto a un puntatore corrotto,
# PC 0x3fcb1414) subito dopo gli aggiornamenti: riportati a 10.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10

# Watchpoint hardware alla fine di ogni stack: se un task trabocca, crash
# immediato con il nome del task ("Stack canary watchpoint triggered"),
# invece di corrompere la memoria vicina e far cadere piu' tardi un altro
# modulo (crash rari nel driver WiFi e in pthread, ottobre 2026).
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# Task degli eventi di sistema (WiFi, IP, PPP): 4 KB invece di 2,3. Con i
# gestori degli eventi WiFi gli restavano 268 byte liberi (misurato il
# 03/10/2026 con l'elenco degli stack di sys_mon).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Intestazioni delle richieste HTTP: con 512 (predefinito) Chrome superava il
# limite dopo il cambio della password del pannello (Authorization e cookie
# piu' lunghi): "Header fields are too long" e pannello inaccessibile (03/10/2026).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1536

# PSRAM octal da 8 MB dell'ESP32-S3R8 (T-ETH-Elite), prima non usata: con la VPN la
# memoria interna libera minima era scesa a 1 KB e l'HTTPS verso GitHub falliva
# (mbedtls -0x7F00). Allocazioni fino a 4 KB nella RAM interna, le grandi
# (buffer TLS) nella PSRAM; 32 KB interni sempre riservati (03/10/2026).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Buffer di WiFi e lwIP anche nella PSRAM: con 8 browser aperti la RAM interna
# scendeva a 15-17 KB, occupata soprattutto dai buffer di rete (collaudo del
# 03/10/2026).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Task IPC (cache, flash, PSRAM): con la PSRAM attiva lo stack libero di ipc0
# calava (444, 412, 372 byte in tre giorni, 05/10/2026). Era 1280 (predefinito).
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048
